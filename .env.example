# 协议类型: qiwei(企微/企业微信) 或 weixin(个微/个人微信)
PROTOCOL=qiwei

# 后端开放平台 API 配置
API_URL=http://your-api-server:8080
GUID=your-instance-guid

# 开放平台认证配置（必需）
APP_KEY=your-app-key
APP_SECRET=your-app-secret

# 回调服务配置
CALLBACK_PORT=9000
CALLBACK_PATH=/callback
CALLBACK_URL=http://your-public-server:9000/callback
CALLBACK_SECRET=your-callback-secret

# OpenAI 配置（用于自动回复）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# 私有化 CDN 配置（可选）
# 企微 CDN 服务地址（端口 34789)
CDN_URL_QIWEI=http://8.138.182.93:34789
# 个微 CDN 服务地址（端口 35789）
CDN_URL_WEIXIN=http://8.138.182.93:35789
